# ------------------------------------------------------------------------------
# FinBridge Production Environment Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
APP_NAME=FinBridge
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Networking & Host
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Secrets (Must be generated via cryptographically secure generator)
SECRET_KEY=replace-with-a-very-long-production-secret-key-at-least-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Managed PostgreSQL (Neon, Render, Supabase)
# Note: Use postgresql+asyncpg:// for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://finbridge_user:SECURE_DB_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/finbridge?ssl=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Production Managed Redis (Upstash or Render Redis)
REDIS_URL=rediss://default:SECURE_REDIS_PASSWORD@sample.upstash.io:6379

# Storage Configuration (AWS S3 or Local Persistent Disk)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/var/data/finbridge/storage

# CORS Settings (Comma-separated list of approved production frontend origins)
ALLOWED_ORIGINS=https://finbridge.vercel.app,https://finbridge-app.vercel.app

# AI Reconciliation Engine (Optional LLM Explanations)
OPENAI_API_KEY=sk-proj-prod-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=10.0
AI_CONFIDENCE_THRESHOLD=0.80
AI_MOCK_FALLBACK=true

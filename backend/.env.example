# FinBridge Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=FinBridge
APP_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (Change for production)
SECRET_KEY=dev-secret-key-must-be-at-least-32-characters-long!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite Async default for zero-config local testing:
DATABASE_URL=sqlite+aiosqlite:///./finbridge.db
# PostgreSQL Async for Production / Docker:
# DATABASE_URL=postgresql+asyncpg://finbridge_user:finbridge_pass@localhost:5432/finbridge_db

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis (Cache & Celery)
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

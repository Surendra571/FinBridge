# ==============================================================================
# FinBridge Environment Configuration Template
# Tagline: Finance. Connected. Verified.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=FinBridge
APP_VERSION=1.0.0

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (Generate via: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16+)
# Local / Docker: postgresql+asyncpg://finbridge_user:finbridge_pass@localhost:5432/finbridge_db
# In-memory testing: sqlite+aiosqlite:///:memory:
DATABASE_URL=postgresql+asyncpg://finbridge_user:finbridge_pass@localhost:5432/finbridge_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (Cache, Sessions & Celery Message Broker)
REDIS_URL=redis://localhost:6379/0

# Background Processing (Celery)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Engine (OpenAI API / LangGraph)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Storage Configuration (Local storage or S3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
